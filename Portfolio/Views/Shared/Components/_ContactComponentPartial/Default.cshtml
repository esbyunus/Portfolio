@model Message

<section id="contact" class="s-contact target-section" >

    <div class="overlay"></div>

    <div class="row narrow section-intro">
        <div class="col-full">
            <h3>Iletisim</h3>
            <h1>@ViewBag.contactTitle</h1>

            <p class="lead">@ViewBag.contactDescription</p>
        </div>
    </div>

    <div class="row contact__main">
        <div class="col-eight tab-full contact__form">
            <form method="post" action="/Contact/SendMessage">
                <fieldset>
                    <div class="form-field">
                        <input name="NameSurname" type="text" id="contactName" placeholder="Adınız Soyadınız" value="" minlength="2" required aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="Email" type="email" id="contactEmail" placeholder="Email Adresiniz" value="" required aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="Subject" type="text" id="contactSubject" placeholder="Konu" value="" class="full-width">
                    </div>
                    <div class="form-field">
                        <textarea name="MessageDetail" id="contactMessage" placeholder="Mesajınız" rows="10" cols="50" required aria-required="true" class="full-width"></textarea>
                    </div>
                    <div class="form-field">
                        <button type="submit" class="full-width btn--primary">Mesaj Gönder</button>
                    </div>
                </fieldset>
            </form>

            <!-- contact-warning -->
            <div class="message-warning">
                Bir şeyler yanlış gitti. Lütfen tekrar deneyiniz!
            </div>

            <!-- contact-success -->
            <div class="message-success">
                Mesajınız gönderildi, teşekkür ederim!<br>
            </div>

        </div>
        <div class="col-four tab-full contact__infos">
            <h4 class="h06">Telefon</h4>
            <p>
                @ViewBag.contactPhone1<br>
                @ViewBag.contactPhone2<br>
            </p>

            <h4 class="h06">Email</h4>
            <p>
                @ViewBag.contactEmail1<br>
                @ViewBag.contactEmail2
            </p>

            <h4 class="h06">Adres</h4>
            <p>
                @ViewBag.contactAddress
            </p>
        </div>

    </div>

</section>

@section Scripts {
    <script src="~/js/contact.js"></script>
}