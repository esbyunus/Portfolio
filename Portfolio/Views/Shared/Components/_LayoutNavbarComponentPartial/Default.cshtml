<div class="main-header">
	<div class="logo-header">
		<a href="/About/AboutList" class="logo">
			Admin Paneli
		</a>
		<button class="navbar-toggler sidenav-toggler ml-auto" type="button" data-toggle="collapse" data-target="collapse" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<button class="topbar-toggler more"><i class="la la-ellipsis-v"></i></button>
	</div>
	<nav class="navbar navbar-header navbar-expand-lg">
		<div class="container-fluid">
			<form class="navbar-left navbar-form nav-search mr-md-3" method="get" action="/Search/Index">
				<div class="input-group">
					<input type="text" name="searchTerm" placeholder="Aranacak Kelimeyi Giriniz ..." class="form-control">
					<div class="input-group-append">
						<button type="submit" class="input-group-text">
							<i class="la la-search search-icon"></i>
						</button>
					</div>
				</div>
			</form>
			<ul class="navbar-nav topbar-nav ml-md-auto align-items-center">
				<li class="nav-item">
					<a class="nav-link" href="/Message/Inbox">
						<i class="la la-envelope"></i>
						@if (ViewBag.UnreadMessageCount > 0)
						{
							<span class="notification bg-success"></span>
						}
					</a>
				</li>
				<li class="nav-item">
					<a href="/Login/Logout" class="btn btn-danger">
						<i class="la la-sign-out"></i> Çıkış Yap
					</a>
				</li>
			</ul>
		</div>
	</nav>
</div>